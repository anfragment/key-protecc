# Copy to macos/signing.env and fill in. Not committed - these identify the person building,
# not the project.
#
# Sourced by macos/bundle.sh. The ${VAR:=value} form means anything already set in the
# environment wins, so a single setting can be overridden for one build:
#
#   KP_SIGN_IDENTITY="Developer ID Application" task bundle

# Apple Developer team ID. Read it from the OU field of your signing certificate:
#   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
: "${KP_TEAM_ID:=ABCDE12345}"

# The app ID your provisioning profile was issued for. Must match exactly.
: "${KP_BUNDLE_ID:=com.example.key-protecc}"

# Profile to embed. Download from developer.apple.com for the app ID above.
: "${KP_PROFILE:=macos/embedded.provisionprofile}"

# "Apple Development" for local work, "Developer ID Application" for a shipping build.
: "${KP_SIGN_IDENTITY:=Apple Development}"
